# Copy to .env and fill in. .env is git-ignored -- never commit real credentials.

# ---------------------------------------------------------------- targets
PRACTICE_URL=https://practice.automationtesting.in
STABLE_URL=https://demo.playwright.dev/todomvc/
API_URL=https://reqres.in

# ------------------------------------------------------------ credentials
# The setup project registers a throwaway account at run time, so these are only
# needed if you want the suite to reuse a specific pre-existing account instead.
PRACTICE_USER_EMAIL=
PRACTICE_USER_PASSWORD=

# Password applied to accounts the suite creates itself.
PRACTICE_NEW_USER_PASSWORD=Demo!Suite#2026
